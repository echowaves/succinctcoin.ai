{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx"
  },
  /*
    6.3: TS skips a `.d.ts` file that has a same-named `.ts` implementation
    sibling (`src/preload.d.ts` next to `src/preload.ts`) in `include` glob
    walking — the `window.succinctcoin` global was never in any program.
    `files:` forces it in (the renderer + the tests read
    `Window['succinctcoin']`).
  */
  "files": ["src/preload.d.ts"],
  "include": ["src/**/*", "test/**/*"]
}
