{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  /*
    plan-packaged-app-boot: this is the TYPECHECK-ONLY program — Vite owns
    the main + preload emit (the node/ssr lib builds in
    `vite.main.config.ts` + `vite.preload.config.ts`, the core inlined,
    externals {`electron`, node builtins}), and the renderer Vite config
    owns `dist/renderer/`. The tsc step in the `build` script typechecks
    the main + preload sources (and `src/preload.d.ts`) WITHOUT emitting —
    no stale tsc emit can reach `dist/` by construction, and the build's
    clean step (`scripts/clean-dist.mjs`) removes any prior-pipeline
    artifacts at the head. The renderer `.ts` modules stay excluded (they
    are the renderer Vite build's input, not the main/preload program).
  */
  "exclude": ["src/renderer"]
}
