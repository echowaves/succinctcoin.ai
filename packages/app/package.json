{
  "name": "@succinctcoin/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && vite build && vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts && node scripts/copy-genesis.mjs",
    "package": "electron-forge package"
  },
  "dependencies": {
    "@succinctcoin/core": "workspace:*"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@types/node": "24.9.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
